{
  "name": "carpe-diem",
  "private": true,
  "version": "1.0.0",
  "description": "CARPE Diem. — Screen sharing, simplified.",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace server run build && npm --workspace client run build",
    "start": "npm --workspace server run start",
    "typecheck": "npm --workspace server run typecheck && npm --workspace client run typecheck",
    "fixtures": "node e2e/fixture-server.mjs",
    "test:server": "node e2e/server-authority.mjs",
    "test:e2e": "node e2e/two-peer.mjs",
    "test": "npm run typecheck && npm run test:server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "optionalDependencies": {
    "playwright": "^1.49.0"
  }
}
